# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data / runtime
inventory-data/
*.db
*.sqlite
*.sqlite3
*.log

# Secrets / local env (never commit)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
infra/dashboard.htpasswd

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# atheris fuzz artifacts (M1, .github/workflows/fuzz.yml) -- corpus is
# CI-cached, not committed; crash-* are local repro files for a live finding.
tools/fuzz/corpus/
tools/fuzz/crash-*

# coverage.py output (M2 quality floor)
.coverage
.coverage.*
htmlcov/

# mutmut mutation-testing scratch output (M2, [tool.mutmut] in pyproject.toml)
# -- regenerated by `wsl -e bash -lc "python3 -m mutmut run"`, not vendored.
mutants/
.mutmut-cache
mutmut-stats.sqlite

# P3-2 ATT&CK scorecard build output (regenerated by `make attack-scorecard`)
eval/attack/out/

# eval-lane detection-accuracy datasets (fetched, not vendored -- see
# eval/detection_accuracy/README.md for licensing/download instructions)
eval/detection_accuracy/evtx-samples/
eval/detection_accuracy/splunk-attack-data/
eval/detection_accuracy/*_eval_results.json

# Claude Code local/editor files (not project artifacts)
.claude/settings.local.json
.claude/launch.json

# --- Public-repo doc policy (2026-07-31 audit) ---
# docs/superpowers/specs/ and docs/posts/ mix legitimate keep-public
# decision-rationale docs with forward-looking build/roadmap plans and
# one-off agent planning drafts (the kind that got moved to fengarde-sec
# in this same audit). New files dropped here are ignored by default so a
# coding session doesn't silently publish an internal plan. If a NEW file
# is genuinely a decision-rationale doc explaining a shipped choice (i.e.
# belongs in the public category, same bar as the files already tracked
# here), commit it explicitly with `git add -f` -- don't just remove the
# ignore rule.
docs/superpowers/specs/*
docs/posts/*

# .claude/ is agent config/scratch, not a project artifact -- ignore
# everything by default and un-ignore specific files the team deliberately
# wants every contributor to get (shared settings, shared skills/agents).
.claude/*
!.claude/settings.json

# E1 audit-log runtime data (append-only JSONL, never committed)
audit*.jsonl
audit*.jsonl.lock
# cross-process audit trim lock (created at runtime by the E1 file lock #6 fix)

# Agent / editor / local scratch (not project artifacts)
.hermes/
.obsidian/
.worktrees/
graphify-out/
IDEA.md

# impeccable skill's per-project design/product state -- local design-tool
# convenience, not product documentation; skill still reads/writes these
# locally, they're just no longer tracked/public
DESIGN.md
PRODUCT.md

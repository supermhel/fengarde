# WS-7 dashboard nginx config.
# Serves the static single-file dashboard AND reverse-proxies a same-origin path
# to OpenSearch so the browser can fetch LIVE alerts without a cross-origin (CORS)
# request. The nginx container is on the compose network, so `opensearch` resolves.
#
# This file is a TEMPLATE (nginx:alpine's official envsubst-on-templates
# entrypoint hook renders /etc/nginx/templates/*.template -> conf.d/*.conf at
# container start, substituting only vars actually present in the container's
# environment -- nginx's own lowercase $host/$uri/$content_type are untouched).
# v0.4 Track S1: ${FENGARDE_API_KEY} lets nginx inject the shared secret on the
# triage proxy so the browser never holds the key.
#
# 2026-08-19: time-range picker. `/api/alerts` and the new `/api/events` proxy
# both take a `?gte=<epoch_millis>` query param on the CLIENT's own request URI
# (nginx always sees the current request's own $arg_* regardless of the "no
# dynamic upstream URI" limitation the /api/alerts comment below documents --
# that limitation is specifically about proxy_pass silently dropping a query
# string when the proxied *upstream* address is itself a variable, which
# never applied to reading $arg_gte off the incoming request).
#
# This used to be a semantic `?range=24h` mapped to an OpenSearch date-math
# string ("now-24h") server-side. Found live (2026-08-19) that both indices'
# `time` field is mapped `format: epoch_millis` (contracts/opensearch-mappings/
# {alerts,events-common}.json) -- an OpenSearch/ES field pinned to that exact
# format parses a range query's bound as a literal number ONLY; it does NOT
# fall back to date-math resolution the way an unrestricted `date` field does,
# so "now-24h" raised `number_format_exception` on every shard that actually
# had matching data. Worse than a visible error: OpenSearch reports shard
# failures as a PARTIAL result with HTTP 200, so the query silently returned
# empty/wrong results instead of surfacing the bug -- exactly the "silent
# wrong answer" class this project's whole fail-closed discipline exists to
# avoid. Fixed by moving the "what does 24h mean" computation to the client
# (trivial: Date.now() - hours*3600000, see index.html's rangeGteMs()) and
# having nginx only validate + passthrough an already-numeric value -- no
# date-math parsing on either side. An invalid/missing/absurd value falls
# through to "0" (epoch start = no effective lower bound), the same
# unrestricted-by-time behavior every endpoint had before this feature
# existed, never a query that raises or silently drops real data.
map $arg_gte $fengarde_gte_ms {
    default "0";
    ~^[0-9]+$ $arg_gte;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Gap-hunt (2026-08-26): the dashboard renders attacker-influenced log
    # fields, so ship defense-in-depth headers. CSP is scoped to same-origin
    # + the page's own inline script/style (single-file dashboard); frame
    # embedding, sniffing, and referrer leakage are hard-blocked.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    # v0.4 Track S2: opt-in basic-auth. Default "off" (main compose file) --
    # the override compose (docker-compose.auth.yml) sets DASHBOARD_AUTH_REALM
    # to a quoted realm string and mounts a real htpasswd over the placeholder
    # baked into the image, so this stays a no-op until explicitly enabled.
    auth_basic ${DASHBOARD_AUTH_REALM};
    auth_basic_user_file /etc/nginx/dashboard.htpasswd;

    location / {
        try_files $uri $uri/ =404;
    }

    # 2026-10-15: cache policy for the Vite console. The HTML entry points must
    # revalidate on every load so a redeploy is picked up immediately (`/` reaches this exact match via the `index` internal redirect);
    # the content-hashed bundles under /assets/ never change in place, so they
    # are cached forever. Each block repeats the server-level security headers
    # because any add_header here drops the inherited ones.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }

    # WP-6.1 (GH-2, owner decision 2026-11-05, option C): browser auth is now
    # SESSION-ONLY. The /api/config.js API-key bootstrap is REMOVED -- the
    # browser never holds FENGARDE_API_KEY. The SPA logs in over RBAC and its
    # session cookie (forwarded unmodified by the /api/auth/ and guard
    # proxies) is the credential ws3's _check_auth accepts ("a session or the
    # API key", triage_api.py). The API key remains valid for MACHINE clients
    # on every route (ws3/auth request still accepts X-Api-Key). Ws3 is the
    # single auth authority; nginx no longer compares the key itself except
    # as an nginx auth_request that passes the request through to ws3's
    # /auth/check (key-OR-session) for routes that reach an auth-less
    # upstream (OpenSearch reads, ops metrics, Prometheus) so those stay
    # authenticated without re-introducing a browser-side key.
    #
    # DX4: same-origin live-alerts endpoint. The front end fetches /api/alerts and
    # nginx proxies it to OpenSearch's alerts-* search. The upstream is resolved at
    # request time via Docker's embedded DNS (127.0.0.11) so nginx still starts even
    # if OpenSearch is not yet up.
    location = /api/alerts {
        # Use a variable so nginx defers DNS resolution until request time (Docker's
        # embedded DNS 127.0.0.11). Without the variable, nginx resolves `opensearch`
        # at startup and fails if the container isn't up yet.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $opensearch "http://${OPENSEARCH_HOST}";

        # POST a JSON query body — the only reliable way to pass query params when
        # using a variable upstream. With a variable, nginx ignores any query string
        # appended to proxy_pass, so URI-search params are silently dropped.
        # This query: newest 50 real rule alerts (excludes ai.results which lack rule_title).
        # SECURITY FIX (WP-6.1): this location talks STRAIGHT to OpenSearch
        # (which never checks X-Api-Key -- DISABLE_SECURITY_PLUGIN=true), so
        # the nginx X-Api-Key comparison is replaced by an auth_request to
        # ws3's /auth/check, the single auth authority: it accepts a valid
        # X-Api-Key (machine clients) OR an active RBAC session cookie
        # (browsers, option C). A caller with neither gets 401 here before
        # OpenSearch is ever reached -- OpenSearch itself cannot enforce
        # this. The subrequest carries the client's Cookie and X-Api-Key
        # headers through the /api/auth/ proxy to ws3 /auth/check.
        auth_request /api/auth/check;

        proxy_pass $opensearch/alerts-*/_search;
        proxy_method POST;
        proxy_set_header Content-Type "application/json";
        proxy_set_header Host $host;
        proxy_set_body '{"size":50,"sort":[{"time":"desc"}],"query":{"bool":{"filter":[{"exists":{"field":"rule_title"}},{"range":{"time":{"gte":$fengarde_gte_ms}}}]}}}';

        # Keep the dashboard resilient: on 5xx / timeout return an empty hits array so
        # the front end falls back to mock data. NOTE: a 404 from OpenSearch (index not
        # yet created on a fresh stack) is NOT intercepted here — it passes through as
        # 404, and the JS `r.ok` check (false for 404) correctly falls back to mock data.
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @alerts_unavailable;
    }

    location @alerts_unavailable {
        default_type application/json;
        return 200 '{"hits":{"hits":[]},"_fengarde_proxy":"opensearch_unavailable"}';
    }

    # 2026-08-19: AI triage surfacing. WS-5's LLM/classifier verdict is real and
    # computed (services/ws5-ai/main.py), and IS persisted -- but as a separate
    # alert_id="ai-{event_id}" document (never overwriting the real rule-fired
    # alert's own document, which a same-id PUT would silently do since
    # OpenSearchStore.index() is a full replace, not a partial merge -- see
    # that file's _alert_payload() docstring). /api/alerts's own query
    # deliberately excludes these (`exists: rule_title`), so until now they
    # were computed, indexed, and never seen by anyone. This proxy fetches
    # them separately; the front end joins them onto their real alert by the
    # shared event_ids field (getAiTriage()/attachAiTriage() in index.html).
    location = /api/ai-triage {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $opensearch "http://${OPENSEARCH_HOST}";
        auth_request /api/auth/check;
        proxy_pass $opensearch/alerts-*/_search;
        proxy_method POST;
        proxy_set_header Content-Type "application/json";
        proxy_set_header Host $host;
        proxy_set_body '{"size":200,"sort":[{"time":"desc"}],"query":{"prefix":{"alert_id":"ai-"}}}';
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @alerts_unavailable;
    }

    # 2026-08-19: Events browser. Raw normalized (post-OCSF, pre-detection)
    # events were always indexed (events-{common,bank,dc}-*, WS-2's real
    # output) but never queryable from the dashboard -- only the scored
    # subset (alerts) was. Same time-range map as /api/alerts.
    location = /api/events {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $opensearch "http://${OPENSEARCH_HOST}";
        auth_request /api/auth/check;
        proxy_pass $opensearch/events-*/_search;
        proxy_method POST;
        proxy_set_header Content-Type "application/json";
        proxy_set_header Host $host;
        proxy_set_body '{"size":100,"sort":[{"time":"desc"}],"query":{"range":{"time":{"gte":$fengarde_gte_ms}}}}';
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @alerts_unavailable;
    }

    # M3: same-origin proxy for the RBAC session API (/auth/login, /auth/logout,
    # /auth/me on ws3-indexer's triage_api.py). Forwards Cookie/Set-Cookie
    # unmodified (nginx's default proxy behavior) so the HttpOnly session
    # cookie round-trips exactly as the backend set it. Also forwards
    # X-Api-Key (empty/no-op when unset) -- needed so GET /auth/me still
    # reaches ws3-indexer's route dispatch (-> a clean 404, meaning "RBAC is
    # off, no login system here") rather than being blocked earlier by the
    # API-key check in the (unusual but valid) deployment combo of
    # FENGARDE_API_KEY set with RBAC off; the front end tells "not logged in"
    # (401) apart from "no login system at all" (404) by this exact status.
    location /api/auth/ {
        # WP-6.1 (option C): the login/bootstrap surface is NOT key-gated --
        # a browser that has not logged in yet could not present a credential,
        # so requiring one here would lock users out. ws3's own routes make
        # the call: /auth/login,/auth/logout,/auth/mfa/* are exempt from
        # _check_auth when RBAC is on; GET /auth/me is reachable (session-only)
        # so the front end tells 401 (logged out, RBAC on) apart from 404
        # (no login system, RBAC off). Machine clients still pass X-Api-Key,
        # which is forwarded so ws3 can accept the key on /auth/check and
        # other key-capable reads.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_auth "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/auth/(.*)$ /auth/$1 break;
        proxy_pass $ws3_auth;
        proxy_set_header Host $host;
        proxy_set_header Content-Type $content_type;
        proxy_set_header X-Api-Key $http_x_api_key;
        # Lets ws3-indexer's opt-in RATE_LIMIT_TRUST_PROXY_HEADER resolve the
        # real client instead of every request collapsing to nginx's own
        # container IP. $remote_addr REPLACES (does not append to) any
        # client-supplied value, so this is not spoofable through nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # C1 (v0.3): same-origin proxy for the triage API (ws3-indexer's
    # triage_api.py, a separate port from the bus/health runner). Unlike the
    # /api/alerts proxy above, this forwards the client's real method/body
    # unmodified (GET for reads, POST {status,note} for updates) -- the
    # front end already handles a proxy/backend failure gracefully (falls
    # back to a local default / keeps the optimistic UI value), so no fake-
    # success fallback is needed here the way it is for the read-only
    # alerts feed.
    location /api/triage/ {
        # WP-6.1 (option C): no nginx key gate here -- triage is served by
        # ws3-indexer, whose _check_auth accepts an X-Api-Key (machine
        # clients) OR an active RBAC session cookie (browsers), and whose
        # _require_role enforces the session role/tenant per route. That is
        # the single auth authority; nginx only forwards the caller-presented
        # key and the session cookie and lets ws3 decide. (This replaced the
        # 2026-08-26 gap-hunt model where the browser held the key via
        # /api/config.js and nginx compared it itself.)
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_triage "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/triage/(.*)$ /$1 break;
        proxy_pass $ws3_triage;
        proxy_set_header Host $host;
        proxy_set_header Content-Type $content_type;
        # Forward the caller-PRESENTED key (never inject one).
        proxy_set_header X-Api-Key $http_x_api_key;
        # Lets ws3-indexer's opt-in RATE_LIMIT_TRUST_PROXY_HEADER resolve the
        # real client instead of every request collapsing to nginx's own
        # container IP. $remote_addr REPLACES (does not append to) any
        # client-supplied value, so this is not spoofable through nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # C3 (v0.5): read-only proxy for GET /rules (rule summaries incl. the
    # optional mitre passthrough, services/ws3-indexer/rules_view.py) -- the
    # dashboard's coverage heatmap reads this. Same ws3-indexer triage port
    # as /api/triage/ above, GET-only in practice (rules_view.py has no
    # write route), no CSRF/body forwarding needed.
    location /api/rules {
        # WP-6.1: auth delegated to ws3 -- key or session (see /api/triage/ for the
        # full account) -- never inject a server-side key.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_rules "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/rules$ /rules break;
        proxy_pass $ws3_rules;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        # Lets ws3-indexer's opt-in RATE_LIMIT_TRUST_PROXY_HEADER resolve the
        # real client instead of every request collapsing to nginx's own
        # container IP. $remote_addr REPLACES (does not append to) any
        # client-supplied value, so this is not spoofable through nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # WS-8 (2026-08-18): read-only proxy for GET /incidents (correlated
    # incidents, services/ws3-indexer/triage_api.py::_route_list_incidents).
    # Same shape as /api/rules above -- GET-only, same triage port, query
    # string (tenant_id/entity_type/entity_value/limit) forwarded unchanged
    # by nginx's default rewrite behavior.
    location /api/incidents {
        # WP-6.1: auth delegated to ws3 -- key or session (see /api/triage/ for the
        # full account) -- never inject a server-side key.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_incidents "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/incidents$ /incidents break;
        proxy_pass $ws3_incidents;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # Phase 5 (2026-09-04): per-incident sub-paths -- GET /incidents/{id}/graph,
    # GET /incidents/{id}/evidence (triage_api.py's route_get_incident_graph/
    # route_get_incident_evidence). Deliberately a SEPARATE block from the
    # exact-match `/api/incidents` list route above, same shape as
    # /api/triage/ vs a hypothetical exact /api/triage would need to be: the
    # trailing slash makes this a prefix match nginx only picks for a path
    # WITH something after /api/incidents/, so the two blocks never collide
    # -- the more specific (longer) match wins per nginx's own location
    # selection rules, verified via `docker compose config`-equivalent
    # (nginx -t) before shipping this file's own precedent elsewhere.
    location /api/incidents/ {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_incidents_sub "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/incidents/(.*)$ /incidents/$1 break;
        proxy_pass $ws3_incidents_sub;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        # Evidence-package assembly builds the package on demand (WP-3-B,
        # triage_api.py::route_get_incident_evidence) -- not a bounded doc
        # GET like every other read route here, so it gets a longer budget.
        proxy_read_timeout 15s;
    }

    # Phase 5 (2026-09-04): GET /entities/{id} (triage_api.py's
    # route_get_entity) -- same shape as /api/incidents/ above.
    location /api/entities/ {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_entities "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/entities/(.*)$ /entities/$1 break;
        proxy_pass $ws3_entities;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # 2026-08-20: WS-6 inventory feed. window.INVENTORY_API (index.html) had no
    # default -- unlike every other *_API constant here -- and nothing anywhere
    # (no compose env, no injected script) ever set it, so the Inventory view
    # showed mock data on EVERY deployment, silently, since it shipped. WS-6's
    # own auth (TenantKeyStore, keystore.py) is a SEPARATE secret system from
    # FENGARDE_API_KEY (the latter was migrated away from as ws6's auth source
    # -- see ensure_legacy_keys_migrated) -- so unlike /api/triage/ above, this
    # does NOT compare against FENGARDE_API_KEY or inject it; the dashboard is
    # valid only if ws6's keystore recognizes the caller-presented key.
    # NEW-hunt read-plane #2 (2026-08-27): this route previously forwarded NO
    # X-Api-Key upstream at all. When ws6 keystore auth was enabled, every
    # dashboard Inventory read got 401 -- the view silently blanked. Now nginx
    # forwards the caller-PRESENTED key ($http_x_api_key, empty/no-op when the
    # browser holds none, matching the zero-config empty-keystore default where
    # ws6 is auth-disabled) and lets ws6 validate it against its own keystore,
    # the same mechanism every other proxied route uses. The browser's key IS
    # valid on ws6 when it came from a FENGARDE_API_KEY/FENGARDE_API_KEYS
    # migration (ensure_legacy_keys_migrated provisions those into the ws6
    # keystore); a manage_keys.py-provisioned ws6-only key needs the browser
    # configured with it -- never silently served an unauthenticated dashboard.
    # Gap-hunt (2026-08-26) #63: the dashboard only READS inventory (/assets,
    # /keys); writes (/assets/upsert etc.) are collector/tool traffic that
    # must go through ws6's own keyed API, never through the same-origin
    # browser proxy. With an empty keystore (the documented zero-config
    # default) an anonymous POST through this proxy would otherwise write
    # arbitrary assets that WS-2 enrichment consults. Restrict to GET/HEAD.
    location /api/inventory/ {
        limit_except GET HEAD {
            deny all;
        }
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws6_inventory "http://ws6-inventory:8000";
        rewrite ^/api/inventory/(.*)$ /$1 break;
        proxy_pass $ws6_inventory;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # 2026-08-20: E1 admin audit trail (services/ws3-indexer/audit.py) -- fully
    # built (login/logout/mfa/triage/report events, append-only, capacity-cap)
    # but had zero dashboard proxy. Same auth pattern as /api/rules: the
    # backend's own _require_role("admin") gate (triage_api.py::_route_audit)
    # does the real access control over the forwarded session cookie; this
    # proxy just gets the request there.
    location /api/audit {
        # WP-6.1: auth delegated to ws3 -- key or session (see /api/triage/ for the
        # full account) -- never inject a server-side key. The backend
        # _require_role("admin") gate still does the real access control over
        # the forwarded session cookie when RBAC is on.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_audit "http://ws3-indexer:${WS3_TRIAGE_PORT}";
        rewrite ^/api/audit$ /audit break;
        proxy_pass $ws3_audit;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # 2026-08-20: per-service ops/health metrics. Every workstream exposes a
    # uniform GET /metrics -> {service, topics:{topic:{result:count}}, extra?}
    # via services/shared/runner.py's health-port server (services/shared/
    # runner.py:204-212) -- real per-topic acked/failed/deadlettered counters
    # plus service-specific extras (WS-1 per-source ingest metrics, WS-4
    # rule-fire-recency, WS-8 correlator track/promotion counts) -- but these
    # health ports were never published to the host AND never proxied here,
    # so an operator had no path to them short of `docker exec` + curl. Same
    # X-Api-Key gate as /api/alerts: these were previously reachable only
    # container-to-container, so proxying them through the (host-published)
    # dashboard is a real posture change worth gating identically, even
    # though the upstream health-port server itself has no auth of its own.
    location /api/ops/ws1 {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws1_ops "http://ws1-collectors:8001";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws1$ /metrics break;
        proxy_pass $ws1_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ops/ws2 {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws2_ops "http://ws2-normalization:8002";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws2$ /metrics break;
        proxy_pass $ws2_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ops/ws3 {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws3_ops "http://ws3-indexer:8003";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws3$ /metrics break;
        proxy_pass $ws3_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ops/ws4 {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws4_ops "http://ws4-detection:8004";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws4$ /metrics break;
        proxy_pass $ws4_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ops/ws5 {
        # Gap-hunt (2026-08-26) #57: ws5-ai WAS the one workstream with no
        # ops/health entry at all -- its /metrics (runner health server, port
        # 8005) was never proxied, so WS-5 dying left the dashboard's Ops
        # view fully green. Same shape/gate as the other five.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws5_ops "http://ws5-ai:8005";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws5$ /metrics break;
        proxy_pass $ws5_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ops/ws8 {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ws8_ops "http://ws8-correlation:8008";
        auth_request /api/auth/check;
        rewrite ^/api/ops/ws8$ /metrics break;
        proxy_pass $ws8_ops;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # 2026-10-15: system-health panel (Operations view). Strictly read-only
    # window onto the opt-in Prometheus (infra/docker-compose.yml, profile
    # `observability`): only GET /api/v1/targets and GET /api/v1/query are
    # reachable. Prometheus has no auth of its own and its admin/tsdb/write/
    # lifecycle endpoints are destructive, so this is an allowlist, not a
    # denylist: the regex location below is the ONLY way through, and the
    # prefix block denies every other /api/prom/ path. nginx matches on the
    # normalized URI ($uri, %-decoded, ../ resolved) and the rewrite passes the
    # normalized path upstream, so encoded/traversal tricks cannot escape the
    # two allowed paths. Same auth_request /auth/check gate as /api/ops/*.
    # No add_header here, so the server-level security headers are inherited.
    # Prometheus not running (profile off) -> resolver failure -> 502, which
    # the console shows as "Prometheus not reachable".
    location /api/prom/ {
        return 403;
    }
    location ~ ^/api/prom/api/v1/(targets|query)$ {
        limit_except GET {
            deny all;
        }
        resolver 127.0.0.11 ipv6=off valid=30s;
        resolver_timeout 1s;  # profile off -> fail fast so the panel says "not reachable" instead of waiting
        set $prometheus "http://prometheus:9090";
        auth_request /api/auth/check;
        rewrite ^/api/prom/(.*)$ /$1 break;
        proxy_pass $prometheus;
        proxy_set_header Host $host;
        # Nothing of the caller's travels upstream: no body, no credentials.
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Api-Key "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }
}

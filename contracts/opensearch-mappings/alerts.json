{
  "index_patterns": ["alerts-*"],
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 1 },
    "mappings": {
      "_meta": { "mapping_version": 4, "_comment": "Correlated/enriched alerts, 1-year retention via ISM (ism-alerts-365d.json attaches by index pattern, not by a template setting). v4: ai.engine/ai.model added so the dashboard can show which LLM actually produced a verdict (ollama vs stub), see services/ws5-ai/llm_adapter.py." },
      "dynamic": "false",
      "properties": {
        "alert_id": { "type": "keyword" },
        "time": { "type": "date", "format": "epoch_millis" },
        "rule_id": { "type": "keyword" },
        "rule_title": { "type": "keyword" },
        "level": { "type": "keyword" },
        "score": { "type": "integer" },
        "sector": { "type": "keyword" },
        "src_endpoint": { "properties": { "ip": { "type": "ip" }, "mac": { "type": "keyword" } } },
        "actor": { "properties": { "user": { "properties": { "name": { "type": "keyword" } } } } },
        "event_ids": { "type": "keyword" },
        "mitre": {
          "properties": {
            "framework": { "type": "keyword" },
            "tactic": { "type": "keyword" },
            "technique": { "type": "keyword" }
          }
        },
        "ai": {
          "properties": {
            "verdict": { "type": "keyword" },
            "summary": { "type": "text" },
            "level": { "type": "keyword" },
            "engine": { "type": "keyword" },
            "model": { "type": "keyword" }
          }
        },
        "siem": { "properties": { "tenant": { "type": "keyword" }, "sector": { "type": "keyword" }, "source_type": { "type": "keyword" } } },
        "tenant_id": { "type": "keyword" }
      }
    }
  }
}
